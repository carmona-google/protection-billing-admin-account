# =============================================================================
# Single-Project GCP Sandbox / POC Deployment Example
# Copy to `single_project.tfvars` (git-ignored) and replace `<...>` placeholders.
# =============================================================================

partner_org_id            = "<YOUR_GCP_ORG_ID>"          # e.g. "123456789012"
parent_billing_account_id = "<YOUR_BILLING_ACCOUNT_ID>"  # e.g. "01A2B3-C4D5E6-F7G8H9"

# For a single-project GCP environment, all three logical planes can point to the same project:
broker_project_id  = "<YOUR_GCP_PROJECT_ID>"
linkers_project_id = "<YOUR_GCP_PROJECT_ID>"
secops_project_id  = "<YOUR_GCP_PROJECT_ID>"

region                      = "europe-southwest1"
watchdog_mode               = "DRY_RUN" # Start in DRY_RUN; flip to ENFORCE after backfill & validation
min_instance_count          = 0         # Set to 1 in production for <10s Watchdog MTTR & <3.5s Broker P95
broker_ingress              = "INGRESS_TRAFFIC_ALL"
firestore_delete_protection   = "DELETE_PROTECTION_DISABLED" # Allows clean `terraform destroy` in sandbox
cloud_run_deletion_protection = false                        # Allows clean `terraform destroy` in sandbox
manage_billing_iam            = false                        # Set true when you hold roles/billing.admin on the Billing Account
finops_approver_emails      = "tu-usuario@tu-dominio.com"

# Images built and pushed to Artifact Registry via `gcloud builds submit`
broker_container_image   = "europe-southwest1-docker.pkg.dev/<YOUR_GCP_PROJECT_ID>/billing-broker/broker-api:v1.1"
watchdog_container_image = "europe-southwest1-docker.pkg.dev/<YOUR_GCP_PROJECT_ID>/billing-broker/security-watchdog:v1.1"

tenants = {
  demo_sandbox_tenant = {
    display_name               = "Demo GCP Tenant"
    billing_subaccount_id      = "<YOUR_BILLING_ACCOUNT_ID>"
    allowed_org_ids            = ["organizations/<YOUR_GCP_ORG_ID>"]
    max_links_per_hour         = 5
    default_project_budget_eur = 100
    security_contact_email     = "tu-usuario@tu-dominio.com"
  }
}
